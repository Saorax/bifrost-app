<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BifrostStudio</AssemblyName>
    <RootNamespace>BifrostStudio</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaVersion>12.0.2</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ReleaseRepo" Value="$(ReleaseRepo)" Condition="'$(ReleaseRepo)' != ''" />
    <AssemblyMetadata Include="AppRepo" Value="$(AppRepo)" Condition="'$(AppRepo)' != ''" />
    <AssemblyMetadata Include="BifrostRepo" Value="$(BifrostRepo)" Condition="'$(BifrostRepo)' != ''" />
    <AssemblyMetadata Include="OfficialRepo" Value="$(OfficialRepo)" Condition="'$(OfficialRepo)' != ''" />
    <AssemblyMetadata Include="AppVersion" Value="$(AppVersion)" Condition="'$(AppVersion)' != ''" />
  </ItemGroup>

</Project>
